---
import { Toggle } from "astro-theme-toggle/components";
import { Icon } from "astro-icon/components";
---

<Toggle
  aria-label="Toggle light/dark mode"
  title="Toggle light/dark mode"
  class="ml-2.5 h-8 w-8"
>
  <Fragment slot="icon-light">
    <Icon
      name="game-icons:sunrise"
      width="26"
      height="26"
      aria-label="light mode active"
      class="text-cream-gold!"
    />
  </Fragment>
  <Fragment slot="icon-dark">
    <Icon
      name="game-icons:night-sky"
      width="26"
      height="26"
      aria-label="dark mode active"
      class="text-coffee-gold!"
    />
  </Fragment>
</Toggle>

<script
  src="https://cdn.jsdelivr.net/npm/iconify-icon@2.1.0/dist/iconify-icon.min.js"
></script>
