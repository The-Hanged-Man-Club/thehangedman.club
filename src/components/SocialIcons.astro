---
import Default from "@astrojs/starlight/components/SocialIcons.astro";
import { Icon } from "astro-icon/components";
---

<div class="flex items-center gap-2">
  <p class="inline">
    <a href="/blog" class="sl-flex h-4" rel="me" title="blog"
      ><Icon name="game-icons:scroll-quill" /></a
    >
  </p>
  <p class="inline">
    <a
      href="mailto:admin@thehangedman.club"
      class="sl-flex h-4"
      rel="me"
      title="email"><Icon name="game-icons:tied-scroll" /></a
    >
  </p>
  <p class="inline">
    <a
      href="https://thehangedmanclub.tumblr.com/"
      class="sl-flex h-4"
      rel="me"
      title="tumblr"><Icon name="simple-icons:tumblr" /></a
    >
  </p>
</div>
<Default>
  <slot />
</Default>
